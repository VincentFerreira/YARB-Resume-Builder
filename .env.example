COOKIES_FILE=cookies.json
POSTS_FILE=posts.json
INTEREST_KEYWORDS=QA,testing,quality assurance,automation,selenium,pytest
RELEVANCE_THRESHOLD=2.0
MAX_SCROLL_ATTEMPTS=3
HEADLESS=true

# Personal Telegram bot (telegram_bot.py)
TELEGRAM_BOT_TOKEN=          # Token from @BotFather
TELEGRAM_USER_ID=            # Your numeric user ID (via @userinfobot)

# Claude Code binary used by the bot to judge post relevance (bot/relevance.py)
CLAUDE_BIN=/usr/local/bin/claude
CLAUDE_TIMEOUT=180
